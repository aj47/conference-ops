{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "conference-ops-app-local",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/events/*/embed/agenda"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "ENVIRONMENT": "local",
    "DEMO_MODE": "true",
    "PUBLIC_APP_URL": "http://localhost:5173",
    "BETTER_AUTH_URL": "http://localhost:5173",
    "ACCELEVENTS_ENABLED": "false",
    "AIRTABLE_ENABLED": "false",
    "AIRTABLE_BASE_ID": "",
    "AIRTABLE_AUTHORITY_DEFAULT": "d1",
    "AIRTABLE_MAX_REQUESTS_PER_SECOND": "4",
    "MAIL_FROM": "program@example.invalid",
    "MAIL_REPLY_TO": "program@example.invalid"
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "REALTIME_TOKEN"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "conference-ops-local",
      "database_id": "local-conference-ops",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "conference-ops-local-uploads"
    }
  ],
  "env": {
    "pilot": {
      "name": "conference-ops-pilot-app",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "pilot",
        "DEMO_MODE": "false",
        "PUBLIC_APP_URL": "__PUBLIC_APP_URL__",
        "BETTER_AUTH_URL": "__PUBLIC_APP_URL__",
        "ACCELEVENTS_ENABLED": "__ACCELEVENTS_ENABLED__",
        "AIRTABLE_ENABLED": "__AIRTABLE_ENABLED__",
        "AIRTABLE_BASE_ID": "__AIRTABLE_BASE_ID__",
        "AIRTABLE_AUTHORITY_DEFAULT": "__AIRTABLE_AUTHORITY_DEFAULT__",
        "AIRTABLE_MAX_REQUESTS_PER_SECOND": "__AIRTABLE_MAX_REQUESTS_PER_SECOND__",
        "MAIL_FROM": "__MAIL_FROM__",
        "MAIL_REPLY_TO": "__MAIL_REPLY_TO__"
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "REALTIME_TOKEN"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "conference-ops-pilot",
          "database_id": "__D1_DATABASE_ID__",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "conference-ops-pilot-uploads"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "JOBS_QUEUE",
            "queue": "conference-ops-pilot-jobs"
          }
        ]
      },
      "services": [
        {
          "binding": "REALTIME",
          "service": "conference-ops-pilot-realtime"
        }
      ],
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      }
    },
    "staging": {
      "name": "conference-ops-staging-app",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "DEMO_MODE": "true",
        "PUBLIC_APP_URL": "__PUBLIC_APP_URL__",
        "BETTER_AUTH_URL": "__PUBLIC_APP_URL__",
        "ACCELEVENTS_ENABLED": "__ACCELEVENTS_ENABLED__",
        "AIRTABLE_ENABLED": "__AIRTABLE_ENABLED__",
        "AIRTABLE_BASE_ID": "__AIRTABLE_BASE_ID__",
        "AIRTABLE_AUTHORITY_DEFAULT": "__AIRTABLE_AUTHORITY_DEFAULT__",
        "AIRTABLE_MAX_REQUESTS_PER_SECOND": "__AIRTABLE_MAX_REQUESTS_PER_SECOND__",
        "MAIL_FROM": "__MAIL_FROM__",
        "MAIL_REPLY_TO": "__MAIL_REPLY_TO__"
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "REALTIME_TOKEN"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "conference-ops-staging",
          "database_id": "__D1_DATABASE_ID__",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "conference-ops-staging-uploads"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "JOBS_QUEUE",
            "queue": "conference-ops-staging-jobs"
          }
        ]
      },
      "services": [
        {
          "binding": "REALTIME",
          "service": "conference-ops-staging-realtime"
        }
      ],
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      }
    },
    "production": {
      "name": "conference-ops-production-app",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "production",
        "DEMO_MODE": "false",
        "PUBLIC_APP_URL": "__PUBLIC_APP_URL__",
        "BETTER_AUTH_URL": "__PUBLIC_APP_URL__",
        "ACCELEVENTS_ENABLED": "__ACCELEVENTS_ENABLED__",
        "AIRTABLE_ENABLED": "__AIRTABLE_ENABLED__",
        "AIRTABLE_BASE_ID": "__AIRTABLE_BASE_ID__",
        "AIRTABLE_AUTHORITY_DEFAULT": "__AIRTABLE_AUTHORITY_DEFAULT__",
        "AIRTABLE_MAX_REQUESTS_PER_SECOND": "__AIRTABLE_MAX_REQUESTS_PER_SECOND__",
        "MAIL_FROM": "__MAIL_FROM__",
        "MAIL_REPLY_TO": "__MAIL_REPLY_TO__"
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "REALTIME_TOKEN"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "conference-ops-production",
          "database_id": "__D1_DATABASE_ID__",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "conference-ops-production-uploads"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "JOBS_QUEUE",
            "queue": "conference-ops-production-jobs"
          }
        ]
      },
      "services": [
        {
          "binding": "REALTIME",
          "service": "conference-ops-production-realtime"
        }
      ],
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.2
        }
      }
    }
  }
}
