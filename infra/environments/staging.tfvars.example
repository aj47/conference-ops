cloudflare_account_id = "00000000000000000000000000000000"
cloudflare_zone_id    = null
environment           = "staging"

d1_primary_location_hint = "wnam"
r2_location              = "wnam"
jobs_queue_retention_seconds = 86400
jobs_dlq_retention_seconds   = 86400

# Enable only after a custom staging hostname exists.
enable_preview_access          = false
preview_access_hostname        = null
preview_access_allowed_emails  = []
preview_access_allowed_idps    = []
preview_access_service_token_ids = []

# Worker custom domains are configured by the Wrangler renderer. Reserve this
# map for other records that Terraform should own.
dns_records = {}
