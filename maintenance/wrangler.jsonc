{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "conference-ops-pilot-app",
  "main": "./index.mjs",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
